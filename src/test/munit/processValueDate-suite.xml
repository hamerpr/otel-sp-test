		<munit:behavior >
			<munit:set-event doc:name="Set API Query Params" doc:id="22df71b7-b7f8-46a9-b28e-52f864bc6038">
				<munit:payload value='#[""]' encoding="UTF-8" />
				<munit:attributes value='#[output application/json&#10;---&#10;{&#10;	"queryParams": {&#10;		"valueDate": "2024-10-24",&#10;		"ccy": "GBP"&#10;	}&#10;}]' mediaType="application/json" />
